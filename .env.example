# Скопируйте в .env и замените все change-me. Этот файл можно коммитить.
SESSION_SECRET=change-me-run-openssl-rand-hex-32
INITIAL_ADMIN_PASSWORD=change-me-admin
LDAP_TLS_VERIFY=false
WINRM_TLS_VERIFY=false

POSTGRES_USER=bloodhound
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=bloodhound
NEO4J_USER=neo4j
NEO4J_SECRET=change-me-neo4j
BLOODHOUND_URL=http://bloodhound-ce:8080
BLOODHOUND_USER=admin
BLOODHOUND_PASSWORD=change-me-bloodhound

# Необязательно. Пустые значения оставляют почту, Telegram и модель выключенными.
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LLM_API_URL=
LLM_MODEL_NAME=
LLM_API_KEY=
USE_LOCAL_LLM=false
