# install.sh creates a random SESSION_SECRET when .env is absent.
# Never deploy this placeholder; run bash install.sh.
SESSION_SECRET=GENERATE_WITH_INSTALL_SH
# Empty = random password saved inside the data volume (initial-admin.txt).
INITIAL_ADMIN_PASSWORD=
HTTPS_PORT=9443
BIND_ADDRESS=0.0.0.0
LDAP_TLS_VERIFY=true
WINRM_TLS_VERIFY=true
USE_LOCAL_LLM=false
# Configure tenant SMTP, Telegram and AI credentials in the authenticated UI.
