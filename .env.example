# Скопируйте в .env и замените все change-me. Этот файл можно коммитить.
SESSION_SECRET=change-me-run-openssl-rand-hex-32
INITIAL_ADMIN_PASSWORD=change-me-admin
LDAP_TLS_VERIFY=false
WINRM_TLS_VERIFY=false

# Необязательно. Пустые значения оставляют почту, Telegram и модель выключенными.
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LLM_API_URL=
LLM_MODEL_NAME=
LLM_API_KEY=
USE_LOCAL_LLM=false
